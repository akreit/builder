# Kopieren nach .env und Werte eintragen (.env ist in .gitignore)
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben
ANTHROPIC_MODEL=
# Optional: Host-Port (Default 8080)
BUILDER_PORT=
# Postgres im Compose-Setup: Passwort selbst wählen (Pflicht); Nutzer/DB optional (Default builder)
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
# Optional: Host-Port für Postgres (Default 5432, nur 127.0.0.1)
POSTGRES_PORT=
